# Copy to .env and replace the example paths. Use forward slashes.

# External data bundle root. It should contain ASR/, Hypersparse-Qwen2.5/,
# Keyframes/, OCR/, qwen-random/, map-keyframes-aic25-b1/, and media-info-aic25-b1/.
HOST_WORKSPACE_ROOT=C:/example/AIC-data

# Directory containing embedding/, keyframe/, and maps/ for L21+L23 retrieval.
HOST_5FPS_DATA=C:/example/AIC-data/kaggle/working/data

# Directory containing the supplied 5-FPS FAISS index and manifest.
HOST_SIGLIP_INDEX_DIR=C:/example/AIC-data/aic-runtime/indexes

# Optional representative BGE embedding file.
HOST_REPRESENTATIVE_EMBEDDINGS=C:/example/AIC-data/aic-runtime/representative_bge_m3_embeddings.npy

# Optional directory containing offline-built l23_scenes.sqlite.
HOST_L23_SCENES_DIR=./data

# Hugging Face cache; required when AIC_OFFLINE_MODELS=1.
HOST_HF_CACHE_DIR=C:/example/huggingface

# Only writable mount: lazy previews and the copied/rebuilt 5-FPS index.
HOST_RUNTIME_DIR=./runtime

# Server and device profile. SigLIP stays on CPU by default.
#
# Local only (default): keep 127.0.0.1. Do NOT expose this app to the open
# internet (it has no login).
#
# Share with ONE trusted friend over Tailscale: set HOST_BIND_ADDRESS=0.0.0.0
# so the tailnet can reach it, then your friend opens
#   http://<your-Tailscale-IP>:5000
PORT=5000
HOST_BIND_ADDRESS=127.0.0.1
AIC_OFFLINE_MODELS=1
AIC_DEVICE=cuda
AIC_SIGLIP_DEVICE=cpu
AIC_RESIDENT_MODELS=1
AIC_PRELOAD_MODELS=1
AIC_ENABLE_QWEN=1
AIC_ENABLE_5FPS=1
AIC_ENABLE_DENSE_ASR=1
AIC_ENABLE_DENSE_REPRESENTATIVE=1
AIC_ENABLE_BTC_CLIP=0
AIC_ENABLE_L23_SCENE_RERANK=1
